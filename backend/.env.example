# ─────────────────────────────────────────────
# ARIA AI — Environment Variables Template
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values
# Windows: copy .env.example .env
# Mac/Linux: cp .env.example .env
#
# NEVER commit .env to GitHub — only .env.example
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# If using Docker (recommended):
DATABASE_URL=postgresql://postgres:password@localhost:5432/aria_ai
# If using manual PostgreSQL setup:
# DATABASE_URL=postgresql://aria:aria_password@localhost:5432/aria_ai

# ── Authentication ─────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── OpenAI (for AI feedback and scoring) ───────
# Get from: platform.openai.com/api-keys
# Required for: LLM feedback, answer scoring, question generation
# NOT required for transcription (Groq handles that)
# Which provider answers, evaluates and scores: "groq" or "openai".
# Groq is the default - its free tier covers chat and Whisper alike.
LLM_PROVIDER=groq

# Groq chat model. Must support streaming AND JSON mode; the small reasoning
# models (openai/gpt-oss-20b) spend their token budget before emitting content.
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Optional: ElevenLabs gives ARIA a human-sounding voice. Without it the app
# uses the browser's own speech synthesis, which is free and unlimited but
# noticeably robotic. The free tier is 10,000 characters/month - about two
# complete AI Meet interviews.
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Only needed when LLM_PROVIDER=openai. Leave blank on the Groq path.
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Groq (for free speech-to-text) ────────────
# Get from: console.groq.com (completely free, no credit card)
# Required for: microphone transcription during interviews
GROQ_API_KEY=your-groq-key-here

# ── Whisper Settings ───────────────────────────
WHISPER_MODEL=whisper-large-v3-turbo

# ── App Settings ───────────────────────────────
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME=ARIA AI
VERSION=1.0.0
API_PREFIX=/api

# ── CORS ───────────────────────────────────────
# Frontend dev server URL — do not change for local development
CORS_ORIGINS=http://localhost:5173

# ── Rate Limiting ──────────────────────────────
# Set to true to disable rate limits during local testing
DISABLE_RATE_LIMITS=false

# ── Database Pool ──────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
SQL_ECHO=false